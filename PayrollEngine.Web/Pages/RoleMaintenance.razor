@page "/user-maintenance/roles"
@using System.Net.Http.Json
@using System.Text.Json
@using PayrollEngine.Web.Services
@inject FeedbackHttpClient Api
@inject FeedbackService Feedback
@inject NavigationManager Navigation

<PageTitle>Szerep karbantartás</PageTitle>

<main class="role-maintenance-page">
    <header class="role-maintenance-header">
        <button type="button" class="role-maintenance-secondary" @onclick="BackToApps">Vissza az alkalmazásokhoz</button>
        <h1>Szerep karbantartás</h1>
    </header>

    <section class="role-maintenance-card">
        <h2>Szerepkörök</h2>

        @if (_isLoading && _roles.Count == 0)
        {
            <p class="role-maintenance-muted">Szerepkörök betöltése…</p>
        }
        else if (_roles.Count == 0)
        {
            <p class="role-maintenance-muted">Még nincs rögzített szerepkör.</p>
        }
        else
        {
            <div class="role-maintenance-table-wrap">
                <table class="role-maintenance-table">
                    <thead>
                        <tr><th>Kód</th><th>Megnevezés</th><th>Állapot</th><th>Művelet</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var role in _roles)
                        {
                            <tr @key="role.RoleId">
                                <td>@role.Code</td>
                                <td>@role.RoleName</td>
                                <td>@(role.IsActive ? "Aktív" : "Inaktív")</td>
                                <td>
                                    <div class="role-maintenance-row-actions">
                                        <button type="button" class="role-maintenance-secondary"
                                                @onclick="() => EditRole(role)" disabled="@_isSaving">
                                            Szerkesztés
                                        </button>
                                        <button type="button" class="role-maintenance-secondary"
                                                @onclick="() => OpenAppDialogAsync(role)">
                                            Alkalmazás-hozzárendelés
                                        </button>
                                        <button type="button" class="role-maintenance-secondary"
                                                @onclick="() => OpenMdgDialogAsync(role)">
                                            MDG-hozzárendelés
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="role-maintenance-card">
        <h2>@(_roleId.HasValue ? "Szerepkör módosítása" : "Új szerepkör")</h2>
        <div class="role-maintenance-form">
            <label>
                Szerepkód <span>*</span>
                <input @bind="_code" maxlength="50" />
            </label>
            <label>
                Megnevezés <span>*</span>
                <input @bind="_roleName" maxlength="100" />
            </label>
            @if (_roleId.HasValue)
            {
                <label class="role-maintenance-checkbox">
                    <input type="checkbox" @bind="_isActive" /> Aktív szerepkör
                </label>
            }
        </div>
        <div class="role-maintenance-actions">
            @if (_roleId.HasValue)
            {
                <button type="button" class="role-maintenance-secondary" @onclick="NewRole" disabled="@_isSaving">
                    Új szerepkör
                </button>
            }
            <button type="button" class="role-maintenance-save" @onclick="SaveAsync" disabled="@_isSaving">
                @(_isSaving ? "Mentés…" : _roleId.HasValue ? "Módosítások mentése" : "Szerepkör létrehozása")
            </button>
        </div>
    </section>

    @if (_appRole is not null)
    {
        <div class="role-maintenance-backdrop" @onclick="CloseAppDialog">
            <section class="role-maintenance-modal" role="dialog" aria-modal="true"
                     aria-labelledby="app-assignment-title" @onclick:stopPropagation="true">
                <header>
                    <div>
                        <h2 id="app-assignment-title">Alkalmazás-hozzárendelés</h2>
                        <p>Szerep: @_appRole.Code — @_appRole.RoleName</p>
                    </div>
                    <button type="button" class="role-maintenance-close" @onclick="CloseAppDialog" aria-label="Ablak bezárása">×</button>
                </header>

                <h3>Hozzárendelt alkalmazások</h3>
                @if (_isLoadingApps)
                {
                    <p class="role-maintenance-muted">Alkalmazások betöltése…</p>
                }
                else if (_assignedApps.Count == 0)
                {
                    <p class="role-maintenance-muted">Ehhez a szerephez még nincs alkalmazás rendelve.</p>
                }
                else
                {
                    <div class="role-maintenance-table-wrap">
                        <table class="role-maintenance-table">
                            <thead><tr><th>Kód</th><th>Alkalmazás</th><th>Művelet</th></tr></thead>
                            <tbody>
                                @foreach (var app in _assignedApps)
                                {
                                    <tr @key="app.AppId">
                                        <td>@app.Code</td>
                                        <td>@app.AppName</td>
                                        <td>
                                            <button type="button" class="role-maintenance-delete"
                                                    @onclick="() => RemoveAppAsync(app)" disabled="@_isChangingApp">
                                                Törlés
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <section class="role-maintenance-modal-section">
                    <h3>Új alkalmazás hozzárendelése</h3>
                    @if (_isLoadingApps)
                    {
                        <p class="role-maintenance-muted">A választható alkalmazások betöltése…</p>
                    }
                    else if (GetUnassignedApps().Count == 0)
                    {
                        <p class="role-maintenance-muted">Nincs további aktív alkalmazás, amely hozzárendelhető.</p>
                    }
                    else
                    {
                        <div class="role-maintenance-assign-form">
                            <label>
                                Alkalmazás
                                <select @bind="_selectedAppId">
                                    <option value="0">Válassz alkalmazást</option>
                                    @foreach (var app in GetUnassignedApps())
                                    {
                                        <option value="@app.AppId">@app.Code — @app.AppName</option>
                                    }
                                </select>
                            </label>
                            <button type="button" class="role-maintenance-save" @onclick="AssignAppAsync"
                                    disabled="@(_isChangingApp || _isLoadingApps || GetUnassignedApps().Count == 0)">
                                @(_isChangingApp ? "Mentés…" : "Hozzárendelés")
                            </button>
                        </div>
                    }
                </section>

                <div class="role-maintenance-actions">
                    <button type="button" class="role-maintenance-secondary" @onclick="CloseAppDialog" disabled="@_isChangingApp">Bezárás</button>
                </div>
            </section>
        </div>
    }

    @if (_mdgRole is not null)
    {
        <div class="role-maintenance-backdrop" @onclick="CloseMdgDialog">
            <section class="role-maintenance-modal role-maintenance-mdg-modal" role="dialog" aria-modal="true"
                     aria-labelledby="mdg-assignment-title" @onclick:stopPropagation="true">
                <header>
                    <div>
                        <h2 id="mdg-assignment-title">MDG-hozzárendelés</h2>
                        <p>Szerep: @_mdgRole.Code — @_mdgRole.RoleName</p>
                    </div>
                    <button type="button" class="role-maintenance-close" @onclick="CloseMdgDialog" aria-label="Ablak bezárása">×</button>
                </header>

                <p class="role-maintenance-muted">Állítsd be, hogy a szerep olvashatja vagy szerkesztheti-e az egyes törzsadatcsoportokat.</p>

                @if (_isLoadingMdg)
                {
                    <p class="role-maintenance-muted">Törzsadatcsoportok betöltése…</p>
                }
                else if (_mdgGroups.Count == 0)
                {
                    <p class="role-maintenance-muted">Nincs megjeleníthető törzsadatcsoport.</p>
                }
                else
                {
                    <div class="role-maintenance-table-wrap">
                        <table class="role-maintenance-table role-maintenance-mdg-table">
                            <thead><tr><th>Csoportkód</th><th>Törzsadatcsoport</th><th>Olvasás</th><th>Szerkesztés</th><th>Művelet</th></tr></thead>
                            <tbody>
                                @foreach (var group in _mdgGroups)
                                {
                                    <tr @key="group.MasterDataGroupId">
                                        <td>@group.Code</td>
                                        <td>@group.Name</td>
                                        <td><input type="checkbox" @bind="group.CanRead" /></td>
                                        <td><input type="checkbox" @bind="group.CanEdit" disabled="@(!group.CanRead)" /></td>
                                        <td>
                                            <button type="button" class="role-maintenance-save role-maintenance-small-save"
                                                    @onclick="() => SaveMdgPermissionAsync(group)"
                                                    disabled="@(_savingMdgId.HasValue || group.CanEdit && !group.CanRead)">
                                                @(_savingMdgId == group.MasterDataGroupId ? "Mentés…" : "Mentés")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="role-maintenance-actions">
                    <button type="button" class="role-maintenance-secondary" @onclick="CloseMdgDialog" disabled="@_savingMdgId.HasValue">Bezárás</button>
                </div>
            </section>
        </div>
    }
</main>

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private readonly List<RoleItem> _roles = [];
    private int? _roleId;
    private string _code = string.Empty;
    private string _roleName = string.Empty;
    private bool _isActive = true;
    private bool _isLoading;
    private bool _isSaving;
    private RoleItem? _appRole;
    private RoleItem? _mdgRole;
    private readonly List<AppItem> _assignedApps = [];
    private readonly List<AppItem> _availableApps = [];
    private readonly List<MdgGroupPermission> _mdgGroups = [];
    private int _selectedAppId;
    private bool _isLoadingApps;
    private bool _isChangingApp;
    private bool _isLoadingMdg;
    private int? _savingMdgId;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_isLoading) return;
        _isLoading = true;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, "api/roles");
            using var response = await Api.SendAsync(
                request,
                fallbackErrorMessage: "A szerepkörök betöltése sikertelen.");
            if (!response.IsSuccessStatusCode)
            {
                _roles.Clear();
                return;
            }

            var items = await response.Content.ReadFromJsonAsync<List<RoleItem>>(JsonOptions);
            _roles.Clear();
            _roles.AddRange(items ?? []);
        }
        catch (HttpRequestException) { }
        catch { Feedback.ShowError("A szerepkörök betöltése közben hiba történt."); }
        finally { _isLoading = false; }
    }

    private async Task SaveAsync()
    {
        if (_isSaving) return;
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_roleName))
        {
            Feedback.ShowError("A szerepkód és a megnevezés megadása kötelező.");
            return;
        }

        var isNew = !_roleId.HasValue;
        _isSaving = true;
        try
        {
            using var request = new HttpRequestMessage(
                isNew ? HttpMethod.Post : HttpMethod.Put,
                isNew ? "api/roles" : $"api/roles/{_roleId}");
            request.Content = isNew
                ? JsonContent.Create(new CreateRoleRequest(_code.Trim(), _roleName.Trim()), options: JsonOptions)
                : JsonContent.Create(new UpdateRoleRequest(_code.Trim(), _roleName.Trim(), _isActive), options: JsonOptions);

            using var response = await Api.SendAsync(
                request,
                fallbackSuccessMessage: isNew ? "A szerepkör létrejött." : "A szerepkör adatai módosultak.",
                fallbackErrorMessage: "A szerepkör mentése sikertelen.");
            if (!response.IsSuccessStatusCode) return;

            NewRole();
            await LoadAsync();
        }
        catch (HttpRequestException) { }
        catch { Feedback.ShowError("A szerepkör mentése közben hiba történt."); }
        finally { _isSaving = false; }
    }

    private void EditRole(RoleItem role)
    {
        _roleId = role.RoleId;
        _code = role.Code;
        _roleName = role.RoleName;
        _isActive = role.IsActive;
    }

    private void NewRole()
    {
        _roleId = null;
        _code = string.Empty;
        _roleName = string.Empty;
        _isActive = true;
    }

    private async Task OpenAppDialogAsync(RoleItem role)
    {
        _appRole = role;
        _selectedAppId = 0;
        _assignedApps.Clear();
        _availableApps.Clear();
        await LoadRoleAppsAsync(role.RoleId);
    }

    private void CloseAppDialog()
    {
        if (_isChangingApp) return;
        _appRole = null;
        _assignedApps.Clear();
        _availableApps.Clear();
        _selectedAppId = 0;
    }

    private async Task LoadRoleAppsAsync(int roleId)
    {
        _isLoadingApps = true;
        try
        {
            using var assignedRequest = new HttpRequestMessage(HttpMethod.Get, $"api/roles/{roleId}/apps");
            using var assignedResponse = await Api.SendAsync(
                assignedRequest,
                fallbackErrorMessage: "A szerephez rendelt alkalmazások betöltése sikertelen.");
            if (!assignedResponse.IsSuccessStatusCode) return;

            using var availableRequest = new HttpRequestMessage(HttpMethod.Get, "api/apps?isActive=true");
            using var availableResponse = await Api.SendAsync(
                availableRequest,
                fallbackErrorMessage: "A választható alkalmazások betöltése sikertelen.");
            if (!availableResponse.IsSuccessStatusCode) return;

            var assigned = await assignedResponse.Content.ReadFromJsonAsync<List<AppItem>>(JsonOptions) ?? [];
            var available = await availableResponse.Content.ReadFromJsonAsync<List<AppItem>>(JsonOptions) ?? [];
            _assignedApps.Clear();
            _assignedApps.AddRange(assigned);
            _availableApps.Clear();
            _availableApps.AddRange(available.Where(app => app.IsActive));
        }
        catch (HttpRequestException) { }
        catch { Feedback.ShowError("Az alkalmazás-hozzárendelések betöltése közben hiba történt."); }
        finally { _isLoadingApps = false; }
    }

    private List<AppItem> GetUnassignedApps() =>
        _availableApps.Where(app => _assignedApps.All(assigned => assigned.AppId != app.AppId)).ToList();

    private async Task AssignAppAsync()
    {
        if (_isChangingApp || _appRole is null) return;
        if (_selectedAppId <= 0)
        {
            Feedback.ShowError("Válassz ki egy alkalmazást.");
            return;
        }

        _isChangingApp = true;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Post, $"api/roles/{_appRole.RoleId}/apps")
            {
                Content = JsonContent.Create(new AssignAppRequest(_selectedAppId), options: JsonOptions)
            };
            using var response = await Api.SendAsync(
                request,
                fallbackSuccessMessage: "Az alkalmazás hozzárendelése sikerült.",
                fallbackErrorMessage: "Az alkalmazás hozzárendelése sikertelen.");
            if (response.IsSuccessStatusCode)
            {
                _selectedAppId = 0;
                await LoadRoleAppsAsync(_appRole.RoleId);
            }
        }
        catch (HttpRequestException) { }
        catch { Feedback.ShowError("Az alkalmazás hozzárendelése közben hiba történt."); }
        finally { _isChangingApp = false; }
    }

    private async Task RemoveAppAsync(AppItem app)
    {
        if (_isChangingApp || _appRole is null) return;
        _isChangingApp = true;
        try
        {
            using var request = new HttpRequestMessage(
                HttpMethod.Delete,
                $"api/roles/{_appRole.RoleId}/apps/{app.AppId}");
            using var response = await Api.SendAsync(
                request,
                fallbackSuccessMessage: "Az alkalmazás-hozzárendelés törlése sikerült.",
                fallbackErrorMessage: "Az alkalmazás-hozzárendelés törlése sikertelen.");
            if (response.IsSuccessStatusCode)
            {
                await LoadRoleAppsAsync(_appRole.RoleId);
            }
        }
        catch (HttpRequestException) { }
        catch { Feedback.ShowError("Az alkalmazás-hozzárendelés törlése közben hiba történt."); }
        finally { _isChangingApp = false; }
    }

    private async Task OpenMdgDialogAsync(RoleItem role)
    {
        _mdgRole = role;
        _mdgGroups.Clear();
        await LoadMdgGroupsAsync(role.RoleId);
    }

    private void CloseMdgDialog()
    {
        if (_savingMdgId.HasValue) return;
        _mdgRole = null;
        _mdgGroups.Clear();
    }

    private async Task LoadMdgGroupsAsync(int roleId)
    {
        _isLoadingMdg = true;
        try
        {
            using var groupsRequest = new HttpRequestMessage(HttpMethod.Get, "api/master-data-groups");
            using var groupsResponse = await Api.SendAsync(
                groupsRequest,
                fallbackErrorMessage: "A törzsadatcsoportok betöltése sikertelen.");
            if (!groupsResponse.IsSuccessStatusCode) return;

            using var permissionsRequest = new HttpRequestMessage(
                HttpMethod.Get,
                $"api/roles/{roleId}/master-data-groups");
            using var permissionsResponse = await Api.SendAsync(
                permissionsRequest,
                fallbackErrorMessage: "A szerep MDG-jogosultságainak betöltése sikertelen.");
            if (!permissionsResponse.IsSuccessStatusCode) return;

            var groups = await groupsResponse.Content.ReadFromJsonAsync<List<MdgGroupItem>>(JsonOptions) ?? [];
            var permissions = await permissionsResponse.Content.ReadFromJsonAsync<List<MdgPermissionItem>>(JsonOptions) ?? [];
            _mdgGroups.Clear();
            _mdgGroups.AddRange(groups.Select(group =>
            {
                var permission = permissions.FirstOrDefault(item => item.MasterDataGroupId == group.MasterDataGroupId);
                return new MdgGroupPermission(
                    group.MasterDataGroupId,
                    group.Code,
                    group.Name,
                    permission?.CanRead ?? false,
                    permission?.CanEdit ?? false);
            }));
        }
        catch (HttpRequestException) { }
        catch { Feedback.ShowError("A szerep MDG-jogosultságainak betöltése közben hiba történt."); }
        finally { _isLoadingMdg = false; }
    }

    private async Task SaveMdgPermissionAsync(MdgGroupPermission group)
    {
        if (_savingMdgId.HasValue || _mdgRole is null) return;
        if (group.CanEdit && !group.CanRead)
        {
            Feedback.ShowError("Szerkesztési jog csak olvasási joggal együtt adható.");
            return;
        }

        _savingMdgId = group.MasterDataGroupId;
        try
        {
            using var request = new HttpRequestMessage(
                HttpMethod.Put,
                $"api/roles/{_mdgRole.RoleId}/master-data-groups")
            {
                Content = JsonContent.Create(
                    new SetMdgPermissionRequest(group.MasterDataGroupId, group.CanRead, group.CanEdit),
                    options: JsonOptions)
            };
            using var response = await Api.SendAsync(
                request,
                fallbackSuccessMessage: "A törzsadatcsoport jogosultságai mentésre kerültek.",
                fallbackErrorMessage: "A törzsadatcsoport jogosultságainak mentése sikertelen.");
        }
        catch (HttpRequestException) { }
        catch { Feedback.ShowError("A törzsadatcsoport jogosultságainak mentése közben hiba történt."); }
        finally { _savingMdgId = null; }
    }

    private void BackToApps() => Navigation.NavigateTo("/apps");

    private sealed record RoleItem(int RoleId, string Code, string RoleName, bool IsActive);
    private sealed record AppItem(int AppId, string Code, string AppName, bool IsActive);
    private sealed record MdgGroupItem(int MasterDataGroupId, string Code, string Name);
    private sealed record MdgPermissionItem(int RoleId, int MasterDataGroupId, string Code, string Name, bool CanRead, bool CanEdit);
    private sealed class MdgGroupPermission(int masterDataGroupId, string code, string name, bool canRead, bool canEdit)
    {
        public int MasterDataGroupId { get; } = masterDataGroupId;
        public string Code { get; } = code;
        public string Name { get; } = name;
        public bool CanRead { get; set; } = canRead;
        public bool CanEdit { get; set; } = canEdit;
    }
    private sealed record AssignAppRequest(int AppId);
    private sealed record SetMdgPermissionRequest(int MasterDataGroupId, bool CanRead, bool CanEdit);
    private sealed record CreateRoleRequest(string Code, string RoleName);
    private sealed record UpdateRoleRequest(string Code, string RoleName, bool IsActive);
}
