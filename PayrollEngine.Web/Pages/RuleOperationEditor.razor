        "resultVariable" => "A visszatérési érték változója",
        _ => Humanize(name)
    };
    private static string Placeholder(string name, string type) => name switch
    {
        "name" => "Például premiumRate",
        "payrollElement" => "Például MUNKAKORIPREMIUM",
        "value" when type == "text" => "Írd be az értéket",
        _ => "Add meg az értéket"
    };
    private static string FormatValueType(string type) => type switch
    {
        "text" => "Szöveg",
        "decimal" => "Tizedes szám",
        "date" => "Dátum",
        "time" => "Idő",
        "boolean" => "Igen / nem",
        "option" => "Választólista",
        "collection" => "Lista",
        "integer" => "Egész szám",
        "dynamic" => "Rugalmas típus",
        _ => type
    };
    private static string Humanize(string value) => System.Text.RegularExpressions.Regex.Replace(value, "([a-z])([A-Z])", "$1 $2");
    private static bool IsExpressionType(string type) => type.EndsWith("Expression", StringComparison.OrdinalIgnoreCase) || type == "collection" || type == "decimal";
    private static bool IsTypedValue(string type) => type == "text" || type == "date" || type == "time" || type == "boolean" || type == "option" || type == "decimal";
}

@code {
    public sealed record RuleOperationItem(string Code, string Category, string Kind, string DisplayName, string? Description,
        string? ResultType, string? Symbol, List<string>? SupportedTypes, List<RuleOperationInput>? Inputs);
    public sealed record RuleOperationInput(string Name, string Type, bool Required, string? SourceCatalog, int? MinimumItems);
    public sealed record RuleDataReference(string Reference, string DisplayName, string? DataType, string? Category);
    public sealed record PayrollElementChoice(int PayrollElementId, string Code, string Name, bool IsActive);
    public sealed record CallableRuleChoice(
        string RuleCode,
        string Name,
        string ReturnType,
        bool IsActive,
        List<CallableRuleParameter> Parameters);
    public sealed record CallableRuleParameter(string Name, string Type);
}
