        "amount" => "Összeg",
        "payrollElement" => "Bérelem",
        "searchText" => "Keresett szöveg",
        "items" => "Lista",
        "itemVariable" => "Listaelem változóneve",
        "steps" => "Végrehajtandó műveletek",
        "digits" => "Tizedesjegyek száma",
        "conditions" => "Feltételek",
