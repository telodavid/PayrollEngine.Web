    private static void AddReference(
        List<string> target,
        string reference)
    {
        if (!string.IsNullOrWhiteSpace(reference) &&
            !target.Contains(reference, StringComparer.OrdinalIgnoreCase))
        {
            target.Add(reference);
        }
    }

    private static void RemoveReference(
        List<string> target,
        string reference)
    {
        target.RemoveAll(item => Same(item, reference));
    }

