    private static void InitializeConstantEditor(ReportValue value)
    {
        if (value.Constant is not { } constant)
        {
            value.ConstantType = "null";
            value.ConstantText = "";
            return;
        }

        value.ConstantType = constant.ValueKind switch
        {
            JsonValueKind.String => "text",
            JsonValueKind.Number => "decimal",
            JsonValueKind.True or JsonValueKind.False => "boolean",
            JsonValueKind.Null or JsonValueKind.Undefined => "null",
            _ => "json"
        };

        value.ConstantText = constant.ValueKind switch
        {
            JsonValueKind.String => constant.GetString() ?? "",
            JsonValueKind.Null or JsonValueKind.Undefined => "",
            _ => constant.GetRawText()
        };
    }

    private static JsonElement BuildConstant(ReportValue value)
    {
        return value.ConstantType switch
        {
            "decimal" => JsonSerializer.SerializeToElement(
                decimal.Parse(
                    value.ConstantText,
                    NumberStyles.Float,
                    CultureInfo.InvariantCulture)),
            "boolean" => JsonSerializer.SerializeToElement(
                bool.Parse(value.ConstantText)),
            "null" => JsonSerializer.SerializeToElement<object?>(null),
            "json" => ParseJson(value.ConstantText),
            _ => JsonSerializer.SerializeToElement(value.ConstantText)
        };
    }

    private static JsonElement ParseJson(string text)
    {
        using var document = JsonDocument.Parse(text);
        return document.RootElement.Clone();
    }

    private string EditorSignature()
    {
        return JsonSerializer.Serialize(new
        {
            Definition = _draft,
            FilterEditorState = _mainFilterEditorState,
            Editors = _draft?.Fields.Select(item => new
            {
                item.Code,
                item.Value.ConstantType,
                item.Value.ConstantText
            }).ToArray()
        }, JsonOptions);
    }

