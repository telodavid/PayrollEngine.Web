    public sealed class ReportDefinition
    {
        public string ReportCode { get; set; } = "";
        public string Name { get; set; } = "";
        public int Version { get; set; } = 1;
        public bool IsActive { get; set; } = true;
        public string LayoutMode { get; set; } = "TABLE";
        public string DataSource { get; set; } = "PAYROLL_RESULT";
        public ReportDateFilter DateFilter { get; set; } = new();
        public List<ReportRelation> Relations { get; set; } = [];
        public string? XmlRootElementName { get; set; }
        public string? XmlRecordElementName { get; set; }
        public string? FileNamePattern { get; set; }
        public List<ReportField> Fields { get; set; } = [];
        public ReportGrouping Grouping { get; set; } = new();
        public List<ReportDocumentFilterEditorDefinition> Filters { get; set; } = [];
        public ReportEmployeeDocumentEditorDefinition? EmployeeDocument { get; set; }

