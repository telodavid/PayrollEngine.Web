    private static string? NullIfEmpty(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static bool Same(string? first, string? second) =>
        string.Equals(
            first,
            second,
            StringComparison.OrdinalIgnoreCase);

