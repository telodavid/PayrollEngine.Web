    private bool ValidateDraft()
    {
        if (_draft is null || !_catalogReady)
            return false;

        if (string.IsNullOrWhiteSpace(_draft.ReportCode) ||
            _draft.ReportCode.Length > 100 ||
            _draft.ReportCode.Any(character =>
                !(char.IsAsciiLetterOrDigit(character) ||
                  character is '_' or '-')))
        {
            _activeTab = 0;
            return Error(
                "A riportkód legfeljebb 100 betűt, számot, aláhúzást és kötőjelet tartalmazhat.");
        }

        if (string.IsNullOrWhiteSpace(_draft.Name) ||
            _draft.Name.Length > 200)
        {
            _activeTab = 0;
            return Error("Adj meg legfeljebb 200 karakteres riportnevet.");
        }

        if (_draft.Version < 1)
        {
            _activeTab = 0;
            return Error("A verziónak pozitívnak kell lennie.");
        }

        if (!Same(_draft.LayoutMode, "TABLE") && !IsEmployeeDocument)
            return Error("Ismeretlen riportmód.");

        if (IsEmployeeDocument && !_supportsEmployeeDocuments)
        {
            _activeTab = 0;
            return Error("Válassz dolgozóhoz kapcsolható fő adatforrást.");
        }

        if (_draft.Fields.Count == 0)
        {
            ShowMainFields();
            return Error("Adj hozzá legalább egy fő kimeneti mezőt.");
        }

        var outputNames = new HashSet<string>(
            StringComparer.OrdinalIgnoreCase);

        foreach (var item in _draft.Fields)
        {
            if (string.IsNullOrWhiteSpace(item.DisplayName) ||
                string.IsNullOrWhiteSpace(item.OutputName) ||
                !outputNames.Add(item.OutputName.Trim()))
            {
                ShowMainFields(item.Code);
                return Error(
                    "A mezőnevek kötelezők, a kimeneti oszlopnevek nem ismétlődhetnek.");
            }

            if (Same(item.Value.Kind, "REFERENCE") &&
                !_references.Any(reference =>
                    Same(reference.Reference, item.Value.Reference)))
            {
                ShowMainFields(item.Code);
                return Error(
                    $"Válassz adatmezőt a találatokból: {item.DisplayName}");
            }

            if (Same(item.Value.Kind, "CONSTANT"))
            {
                try
                {
                    BuildConstant(item.Value);
                }
                catch
                {
                    ShowMainFields(item.Code);
                    return Error(
                        $"Érvénytelen állandó érték: {item.DisplayName}");
                }
            }
            else if (!Same(item.Value.Kind, "REFERENCE"))
            {
                ShowMainFields(item.Code);
                return Error(
                    $"Ismeretlen értékforrás: {item.DisplayName}");
            }

            if (Same(_draft.Grouping.RowMode, "GROUPED") &&
                !Same(item.Aggregation, "NONE") &&
                !Same(item.Value.Kind, "REFERENCE"))
            {
                ShowMainFields(item.Code);
                return Error("Összesítés csak adatmezőn használható.");
            }
        }

        if (Same(_draft.Grouping.RowMode, "GROUPED") &&
            _draft.Grouping.GroupBy.Count == 0)
        {
            _activeTab = 2;
            return Error("Válassz legalább egy csoportosító mezőt.");
        }

        if (_mainFilterEditor is null)
        {
            _activeTab = 2;
            return Error("A szűrőszerkesztő még nincs betöltve.");
        }

        if (!_mainFilterEditor.Validate())
        {
            _activeTab = 2;
            return false;
        }

        if (!ValidateDateDefinition())
        {
            _activeTab = 0;
            return false;
        }

        if (IsEmployeeDocument)
        {
            if (_draft.EmployeeDocument is null ||
                _sectionsDocumentEditor is null ||
                _headerDocumentEditor is null)
            {
                _activeTab = 1;
                return Error(
                    "A dokumentumszerkesztők még nincsenek betöltve.");
            }

            if (!_sectionsDocumentEditor.Validate())
            {
                _activeTab = 1;
                _selectedDataSectionCode =
                    _sectionsDocumentEditor.InvalidSectionCode ?? "__main";

                return false;
            }

            if (!_headerDocumentEditor.Validate())
            {
                _activeTab = 3;
                return false;
            }
        }

        return true;
    }

    private void ShowMainFields(string? code = null)
    {
        _activeTab = 1;
        _selectedDataSectionCode = "__main";
        _expandedFieldCode = code;
    }

    private bool ValidateDateDefinition()
    {
        if (_draft is null)
            return false;

        var filter = _draft.DateFilter;

        if (Same(filter.Mode, "NONE"))
            return true;

        if (Same(filter.Mode, "MONTH_RANGE"))
        {
            var reference =
                NullIfEmpty(filter.DateField) ?? _sourceValidity?.DateField;

            return RootMonthFields.Any(item =>
                       Same(item.Reference, reference)) ||
                   Error("A havi szűréshez válassz periódusmezőt.");
        }

        if (!Same(filter.Mode, "AS_OF_DATE") &&
            !Same(filter.Mode, "DATE_RANGE"))
        {
            return Error("Ismeretlen dátumszűrési mód.");
        }

        if (UsesValidityRange)
        {
            var from = NullIfEmpty(filter.ValidFromField)
                ?? _sourceValidity?.ValidFromField;

            var to = NullIfEmpty(filter.ValidToField)
                ?? _sourceValidity?.ValidToField;

            return
                (RootDateFields.Any(item => Same(item.Reference, from)) &&
                 (to is null ||
                  RootDateFields.Any(item => Same(item.Reference, to)))) ||
                Error("Válassz érvényes kezdő és záró dátummezőt.");
        }

        var dateReference =
            NullIfEmpty(filter.DateField) ?? _sourceValidity?.DateField;

        return RootDateFields.Any(item =>
                   Same(item.Reference, dateReference)) ||
               Error("Válaszd ki a vizsgált dátummezőt.");
    }

    private async Task SaveAsync()
    {
        if (IsBusy || !ValidateDraft())
            return;

        _isSaving = true;

        var previousTab = _activeTab;
        var previousSection = _selectedDataSectionCode;
        var employeeFilter = _employeeIdsText;
        var companyFilter = _companyIdText;

        try
        {
            if (IsEmployeeDocument)
            {
                _sectionsDocumentEditor!.NormalizeForSave();
                _headerDocumentEditor!.NormalizeForSave();
            }

            _mainFilterEditor!.NormalizeForSave();

            var payload = PreparePayload(_draft!);

            using var request = new HttpRequestMessage(
                _isNew ? HttpMethod.Post : HttpMethod.Put,
                _isNew
                    ? "api/reports"
                    : $"api/reports/{Uri.EscapeDataString(payload.ReportCode)}")
            {
                Content = JsonContent.Create(
                    payload,
                    options: JsonOptions)
            };

            using var response = await Api.SendAsync(
                request,
                fallbackSuccessMessage: "A riport mentése sikerült.",
                fallbackErrorMessage: "A riport mentése sikertelen.");

            if (response.IsSuccessStatusCode)
            {
                await LoadReportsAsync(payload.ReportCode);

                _employeeIdsText = employeeFilter;
                _companyIdText = companyFilter;
                _activeTab =
                    previousTab == 3 && !IsEmployeeDocument
                        ? 0
                        : previousTab;

                _selectedDataSectionCode =
                    Same(previousSection, "__main") ||
                    _draft?.EmployeeDocument?.AdditionalSections.Any(item =>
                        Same(item.Code, previousSection)) == true
                        ? previousSection
                        : "__main";
            }
        }
        catch (HttpRequestException)
        {
        }
        catch
        {
            Feedback.ShowError("A riport mentése közben hiba történt.");
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static ReportDefinition PreparePayload(
        ReportDefinition source)
    {
        var payload = Clone(source);

        payload.ReportCode = payload.ReportCode.Trim();
        payload.Name = payload.Name.Trim();

        NormalizeDateFilter(payload.DateFilter);

        foreach (var relation in payload.Relations)
            NormalizeDateFilter(relation.DateFilter);

        foreach (var key in payload.AdditionalProperties.Keys
                     .Where(item => Same(item, "filters"))
                     .ToArray())
        {
            payload.AdditionalProperties.Remove(key);
        }

        foreach (var filter in payload.Filters)
        {
            filter.Field = filter.Field.Trim();
            filter.Operator = filter.Operator.Trim().ToUpperInvariant();
            filter.Parameter = NullIfEmpty(filter.Parameter);

            if (filter.Operator is "IS_NULL" or "IS_NOT_NULL")
            {
                filter.Parameter = null;
                filter.Constant = null;
            }
            else if (filter.Parameter is not null)
            {
                filter.Constant = null;
            }
        }

        for (var index = 0; index < payload.Fields.Count; index++)
        {
            var item = payload.Fields[index];

            item.DisplayName = item.DisplayName.Trim();
            item.OutputName = item.OutputName.Trim();
            item.Format = NullIfEmpty(item.Format);

            if (Same(item.Value.Kind, "CONSTANT"))
            {
                item.Value.Reference = null;
                item.Value.Constant =
                    BuildConstant(source.Fields[index].Value);
            }
            else
            {
                item.Value.Reference =
                    NullIfEmpty(item.Value.Reference);

                item.Value.Constant = null;
            }
        }

        if (Same(payload.LayoutMode, "EMPLOYEE_DOCUMENT"))
            payload.Grouping.SplitFilesBy.Clear();

        return payload;
    }

    private static void NormalizeDateFilter(ReportDateFilter filter)
    {
        filter.Mode =
            (filter.Mode ?? "NONE").Trim().ToUpperInvariant();

        filter.DateField = NullIfEmpty(filter.DateField);
        filter.ValidFromField = NullIfEmpty(filter.ValidFromField);
        filter.ValidToField = NullIfEmpty(filter.ValidToField);
    }

    private bool NeedsDateMode(string mode)
    {
        if (_draft is null)
            return false;

        if (Same(_draft.DateFilter.Mode, mode) ||
            _draft.Relations.Any(item =>
                Same(item.DateFilter.Mode, mode)))
        {
            return true;
        }

        if (!Same(_draft.DateFilter.Mode, "NONE"))
            return false;

        if (IsEmployeeDocument)
        {
            var modes = DocumentDateModes();

            var preferred = modes.Contains("MONTH_RANGE")
                ? "MONTH_RANGE"
                : modes.Contains("DATE_RANGE")
                    ? "DATE_RANGE"
                    : modes.Contains("AS_OF_DATE")
                        ? "AS_OF_DATE"
                        : "NONE";

            if (!Same(preferred, "NONE"))
                return Same(preferred, mode);
        }

        var hasRelationDates = _draft.Relations.Any(item =>
            !Same(item.DateFilter.Mode, "NONE"));

        return !hasRelationDates &&
               MainUsesDynamicFields &&
               Same(mode, "AS_OF_DATE");
    }

    private HashSet<string> DocumentDateModes()
    {
        var modes = new HashSet<string>(
            StringComparer.OrdinalIgnoreCase);

        void AddMode(string? value)
        {
            var normalized = value?.Trim().ToUpperInvariant();

            if (normalized?.StartsWith(
                    "MONTH_RANGE",
                    StringComparison.Ordinal) == true)
            {
                modes.Add("MONTH_RANGE");
            }
            else if (normalized?.StartsWith(
                         "DATE_RANGE",
                         StringComparison.Ordinal) == true)
            {
                modes.Add("DATE_RANGE");
            }
            else if (normalized == "AS_OF_DATE")
            {
                modes.Add("AS_OF_DATE");
            }
        }

        foreach (var block in ActiveDocumentBlocks())
        {
            AddMode(block.DateFilter.Mode);

            foreach (var relation in block.Relations)
                AddMode(relation.DateFilter.Mode);

            foreach (var parameter in block.Parameters)
                AddMode(parameter.Mode);
        }

        return modes;
    }

    private IEnumerable<ReportDocumentDataBlockEditorDefinition>
        ActiveDocumentBlocks()
    {
        var configuration = _draft?.EmployeeDocument;

        if (!IsEmployeeDocument || configuration is null)
            yield break;

        if (configuration.Header.IsEnabled &&
            configuration.Header.Fields.Count > 0)
        {
            yield return configuration.Header;
        }

        foreach (var section in configuration.AdditionalSections)
        {
            if (section.IsEnabled)
                yield return section;
        }
    }

    private async Task ExportAsync()
    {
        if (_draft is null || IsBusy || _isNew ||
            IsDirty || !_catalogReady || !_draft.IsActive)
        {
            return;
        }

        if (!ValidateDraft())
            return;

        var export = new ReportExportRequest
        {
            Format = _exportFormat
        };

        if (IsEmployeeDocument &&
            _exportFormat is not ("XLSX" or "PDF"))
        {
            Error("A dolgozónkénti dokumentum Excel vagy PDF lehet.");
            return;
        }

        if (NeedsDateMode("MONTH_RANGE"))
        {
            if (!TryParseMonth(_periodFrom, out var from) ||
                !TryParseMonth(_periodTo, out var to) ||
                from > to)
            {
                Error("Adj meg érvényes kezdő és záró hónapot.");
                return;
            }

            export.PeriodFrom = _periodFrom;
            export.PeriodTo = _periodTo;
        }

        if (NeedsDateMode("AS_OF_DATE"))
        {
            if (!TryParseDate(_asOfDate, out var date))
            {
                Error("Adj meg érvényes érvényességi dátumot.");
                return;
            }

            export.AsOfDate = date;
        }

        if (NeedsDateMode("DATE_RANGE"))
        {
            if (!TryParseDate(_dateFrom, out var from) ||
                !TryParseDate(_dateTo, out var to) ||
                from > to)
            {
                Error("Adj meg érvényes kezdő és záró dátumot.");
                return;
            }

            export.DateFrom = from;
            export.DateTo = to;
        }

        if (CanFilterEmployees)
        {
            if (!TryParseEmployeeIds(_employeeIdsText, out var ids))
            {
                Error("A dolgozóazonosítók pozitív egész számok legyenek.");
                return;
            }

            export.EmployeeIds = ids;
        }

        if (CanFilterCompany &&
            !string.IsNullOrWhiteSpace(_companyIdText))
        {
            if (!int.TryParse(_companyIdText, out var companyId) ||
                companyId <= 0)
            {
                Error("A cégazonosítónak pozitív egész számnak kell lennie.");
                return;
            }

            export.CompanyId = companyId;
        }

        _isExporting = true;

        try
        {
            using var request = new HttpRequestMessage(
                HttpMethod.Post,
                $"api/reports/{Uri.EscapeDataString(_draft.ReportCode)}/export")
            {
                Content = JsonContent.Create(
                    export,
                    options: JsonOptions)
            };

            using var response = await Api.SendAsync(
                request,
                fallbackErrorMessage: "A riport exportálása sikertelen.");

            if (!response.IsSuccessStatusCode)
                return;

            var bytes =
                await response.Content.ReadAsByteArrayAsync();

            var fileName =
                response.Content.Headers.ContentDisposition?.FileNameStar
                ?? response.Content.Headers.ContentDisposition?.FileName
                ?? $"{_draft.ReportCode}.{_exportFormat.ToLowerInvariant()}";

            var mediaType =
                response.Content.Headers.ContentType?.MediaType
                ?? "application/octet-stream";

            await using var module =
                await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./js/download.js");

            await module.InvokeVoidAsync(
                "saveBytes",
                fileName.Trim('"'),
                mediaType,
                bytes);
        }
        catch (HttpRequestException)
        {
        }
        catch (JSException)
        {
            Feedback.ShowError(
                "A fájl elkészült, de a böngésző nem tudta elindítani a letöltést.");
        }
        catch
        {
            Feedback.ShowError(
                "Az exportálás közben hiba történt.");
        }
        finally
        {
            _isExporting = false;
        }
    }

