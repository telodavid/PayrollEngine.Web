    {
        "value" => "Értékek",
        "variable" => "Változók",
        "comparison" => "Feltételek",
        "arithmetic" => "Számítások",
        "math" => "Számítások",
        "logic" => "Logikai műveletek",
        "collection" => "Listák és ciklusok",
        "controlFlow" => "Vezérlés",
        "payroll" => "Bérelemek",
        "payrollResult" => "Számfejtési eredmény",
        _ => string.IsNullOrWhiteSpace(category) ? "Egyéb" : category
    };

    private static string FormatValueType(string type) => type switch
    {
        "text" => "Szöveg",
        "decimal" => "Tizedes szám",
        "integer" => "Egész szám",
        "date" => "Dátum",
        "time" => "Idő",
        "boolean" => "Igen / nem",
        "option" => "Választólista",
        "collection" => "Lista",
        "dynamic" => "Rugalmas típus",
        _ => type
    };

