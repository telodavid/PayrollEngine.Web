@page "/masterdata/constants"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Konstansok karbantartása</PageTitle>

<div class="constant-page">
    <header class="constant-header">
        <button class="constant-secondary" @onclick="BackToApps">
            Vissza az alkalmazásokhoz
        </button>
        <h1>Konstansok karbantartása</h1>
    </header>

    <div class="constant-toolbar">
        <p>A rendszerben rögzített konstansok és érvényességi időszakok.</p>
        <button class="constant-primary" @onclick="OpenCreate">
            Új konstans
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="constant-message error">@_error</div>
    }

    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <div class="constant-message success">@_success</div>
    }

    @if (_loading)
    {
        <div class="constant-empty">Konstansok betöltése…</div>
    }
    else if (_items.Count == 0)
    {
        <div class="constant-empty">Még nincs rögzített konstans.</div>
    }
    else
    {
        <div class="constant-table-wrap">
            <table class="constant-table">
                <thead>
                    <tr>
                        <th>Azonosító</th>
                        <th>Megnevezés</th>
                        <th>Érték</th>
                        <th>Érvényesség kezdete</th>
                        <th>Érvényesség vége</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr>
                            <td>@item.ConstantId</td>
                            <td>@item.ConstantName</td>
                            <td>@FormatValue(item.Value)</td>
                            <td>@FormatDate(item.ValidFrom)</td>
                            <td>@FormatDate(item.ValidTo)</td>
                            <td class="constant-actions">
                                <button class="constant-secondary"
                                        @onclick="() => OpenEdit(item)">
                                    Szerkesztés
                                </button>
                                <button class="constant-delete"
                                        @onclick="() => AskDelete(item)">
                                    Törlés
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_editing)
{
    <div class="constant-backdrop" @onclick="CloseEditor">
        <section class="constant-dialog"
                 role="dialog"
                 aria-modal="true"
                 @onclick:stopPropagation="true">
            <header>
                <h2>@(_editingId is null ? "Új konstans" : "Konstans szerkesztése")</h2>
                <button class="constant-close"
                        @onclick="CloseEditor"
                        aria-label="Bezárás">
                    ×
                </button>
            </header>

            <div class="constant-form">
                <label>
                    Azonosító
                    <input @bind="_constantId"
                           maxlength="5"
                           disabled="@(_editingId is not null)" />
                </label>

                <label>
                    Megnevezés
                    <input @bind="_constantName" maxlength="50" />
                </label>

                <label>
                    Érték
                    <input type="number"
                           step="0.000001"
                           @bind="_value" />
                </label>

                <label>
                    Érvényesség kezdete
                    <input type="date"
                           @bind="_validFrom"
                           disabled="@(_editingId is not null)" />
                </label>

                <label>
                    Érvényesség vége
                    <input type="date" @bind="_validTo" />
                </label>
            </div>

            @if (_editingId is not null)
            {
                <p class="constant-note">
                    Az azonosító és a kezdődátum a rekord kulcsa, ezért szerkesztéskor nem módosítható.
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(_editorError))
            {
                <div class="constant-message error">@_editorError</div>
            }

            <footer>
                <button class="constant-secondary"
                        @onclick="CloseEditor"
                        disabled="@_saving">
                    Mégse
                </button>
                <button class="constant-primary"
                        @onclick="SaveAsync"
                        disabled="@_saving">
                    @(_saving ? "Mentés…" : "Mentés")
                </button>
            </footer>
        </section>
    </div>
}

@if (_deleteCandidate is not null)
{
    <div class="constant-backdrop" @onclick="CancelDelete">
        <section class="constant-dialog constant-confirm"
                 role="dialog"
                 aria-modal="true"
                 @onclick:stopPropagation="true">
            <h2>Konstans törlése</h2>
            <p>
                Törlöd ezt a verziót?
                <strong>@_deleteCandidate.ConstantId</strong> —
                @_deleteCandidate.ConstantName,
                érvényes: @FormatDate(_deleteCandidate.ValidFrom)
            </p>

            @if (!string.IsNullOrWhiteSpace(_editorError))
            {
                <div class="constant-message error">@_editorError</div>
            }

            <footer>
                <button class="constant-secondary"
                        @onclick="CancelDelete"
                        disabled="@_saving">
                    Mégse
                </button>
                <button class="constant-delete"
                        @onclick="DeleteAsync"
                        disabled="@_saving">
                    @(_saving ? "Törlés…" : "Törlés")
                </button>
            </footer>
        </section>
    </div>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions =
        new(JsonSerializerDefaults.Web);

    private readonly List<ConstantItem> _items = [];

    private bool _loading = true;
    private bool _saving;
    private bool _editing;
    private string? _editingId;
    private ConstantItem? _deleteCandidate;

    private string _constantId = string.Empty;
    private string _constantName = string.Empty;
    private decimal _value;
    private DateTime? _validFrom;
    private DateTime? _validTo;

    private string? _error;
    private string? _success;
    private string? _editorError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            using var response = await SendAsync(
                HttpMethod.Get,
                "api/constants");

            if (!response.IsSuccessStatusCode)
            {
                _error = await ReadErrorAsync(response);
                return;
            }

            var items =
                await response.Content.ReadFromJsonAsync<List<ConstantItem>>(
                    JsonOptions);

            _items.Clear();
            if (items is not null)
            {
                _items.AddRange(items);
            }
        }
        catch (Exception exception)
        {
            _error = $"A konstansok betöltése sikertelen: {exception.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void BackToApps()
    {
        Navigation.NavigateTo("/apps");
    }

    private void OpenCreate()
    {
        _editingId = null;
        _constantId = string.Empty;
        _constantName = string.Empty;
        _value = 0;
        _validFrom = DateTime.Today;
        _validTo = null;
        _editorError = null;
        _editing = true;
    }

    private void OpenEdit(ConstantItem item)
    {
        _editingId = item.ConstantId;
        _constantId = item.ConstantId;
        _constantName = item.ConstantName;
        _value = item.Value;
        _validFrom = item.ValidFrom.ToDateTime(TimeOnly.MinValue);
        _validTo = item.ValidTo?.ToDateTime(TimeOnly.MinValue);
        _editorError = null;
        _editing = true;
    }

    private void CloseEditor()
    {
        if (!_saving)
        {
            _editing = false;
            _editorError = null;
        }
    }

    private async Task SaveAsync()
    {
        _editorError = ValidateForm();
        if (_editorError is not null)
        {
            return;
        }

        _saving = true;

        try
        {
            HttpResponseMessage response;

            if (_editingId is null)
            {
                var request = new CreateConstantRequest(
                    _constantId.Trim(),
                    _constantName.Trim(),
                    _value,
                    DateOnly.FromDateTime(_validFrom!.Value),
                    ToDateOnly(_validTo));

                response = await SendAsync(
                    HttpMethod.Post,
                    "api/constants",
                    request);
            }
            else
            {
                var validFrom = DateOnly.FromDateTime(_validFrom!.Value);
                var request = new UpdateConstantRequest(
                    _constantName.Trim(),
                    _value,
                    ToDateOnly(_validTo));

                var path =
                    $"api/constants/{Uri.EscapeDataString(_editingId)}/{validFrom:yyyy-MM-dd}";

                response = await SendAsync(HttpMethod.Put, path, request);
            }

            using (response)
            {
                if (!response.IsSuccessStatusCode)
                {
                    _editorError = await ReadErrorAsync(response);
                    return;
                }
            }

            var wasEdit = _editingId is not null;
            _editing = false;
            await LoadAsync();
            _success = wasEdit
                ? "A konstans módosítása sikerült."
                : "A konstans rögzítése sikerült.";
        }
        catch (Exception exception)
        {
            _editorError = $"A mentés sikertelen: {exception.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private string? ValidateForm()
    {
        if (_editingId is null
            && (string.IsNullOrWhiteSpace(_constantId)
                || _constantId.Trim().Length > 5))
        {
            return "Az azonosító megadása kötelező, legfeljebb 5 karakter lehet.";
        }

        if (string.IsNullOrWhiteSpace(_constantName)
            || _constantName.Trim().Length > 50)
        {
            return "A megnevezés megadása kötelező, legfeljebb 50 karakter lehet.";
        }

        if (_validFrom is null)
        {
            return "Az érvényesség kezdetének megadása kötelező.";
        }

        if (_validTo.HasValue
            && _validTo.Value.Date < _validFrom.Value.Date)
        {
            return "Az érvényesség vége nem lehet korábbi a kezdeténél.";
        }

        return null;
    }

    private void AskDelete(ConstantItem item)
    {
        _deleteCandidate = item;
        _editorError = null;
    }

    private void CancelDelete()
    {
        if (!_saving)
        {
            _deleteCandidate = null;
            _editorError = null;
        }
    }

    private async Task DeleteAsync()
    {
        if (_deleteCandidate is null)
        {
            return;
        }

        _saving = true;
        _editorError = null;

        try
        {
            var path =
                $"api/constants/{Uri.EscapeDataString(_deleteCandidate.ConstantId)}/{_deleteCandidate.ValidFrom:yyyy-MM-dd}";

            using var response = await SendAsync(HttpMethod.Delete, path);

            if (!response.IsSuccessStatusCode)
            {
                _editorError = await ReadErrorAsync(response);
                return;
            }

            _deleteCandidate = null;
            await LoadAsync();
            _success = "A konstans törlése sikerült.";
        }
        catch (Exception exception)
        {
            _editorError = $"A törlés sikertelen: {exception.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<HttpResponseMessage> SendAsync(
        HttpMethod method,
        string path,
        object? body = null)
    {
        using var request = new HttpRequestMessage(method, path);

        if (body is not null)
        {
            request.Content = JsonContent.Create(body, options: JsonOptions);
        }

        request.SetBrowserRequestCredentials(
            BrowserRequestCredentials.Include);

        return await Http.SendAsync(request);
    }

    private static async Task<string> ReadErrorAsync(
        HttpResponseMessage response)
    {
        try
        {
            using var document = await JsonDocument.ParseAsync(
                await response.Content.ReadAsStreamAsync());

            if (document.RootElement.TryGetProperty("message", out var message))
            {
                return message.GetString() ?? "A kérés sikertelen.";
            }

            if (document.RootElement.TryGetProperty("title", out var title))
            {
                return title.GetString() ?? "A kérés sikertelen.";
            }
        }
        catch
        {
        }

        return $"A kérés sikertelen (HTTP {(int)response.StatusCode}).";
    }

    private static DateOnly? ToDateOnly(DateTime? date)
        => date.HasValue ? DateOnly.FromDateTime(date.Value) : null;

    private static string FormatDate(DateOnly? date)
        => date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "—";

    private static string FormatValue(decimal value)
        => value.ToString("0.######", CultureInfo.InvariantCulture);

    private sealed record ConstantItem(
        string ConstantId,
        string ConstantName,
        decimal Value,
        DateOnly ValidFrom,
        DateOnly? ValidTo);

    private sealed record CreateConstantRequest(
        string ConstantId,
        string ConstantName,
        decimal Value,
        DateOnly ValidFrom,
        DateOnly? ValidTo);

    private sealed record UpdateConstantRequest(
        string ConstantName,
        decimal Value,
        DateOnly? ValidTo);
}